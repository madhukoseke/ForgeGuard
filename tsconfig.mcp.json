{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["es2021"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "noEmitOnError": true
  },
  "include": ["mcp/**/*.ts", "lib/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
