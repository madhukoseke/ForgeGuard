{
  "$comment": "Copy to forgeguard.config.json (or point FORGEGUARD_CONFIG at it). Read-side data safeguards enforced before any statement reaches your database.",
  "denied_tables": ["api_keys", "secrets", "auth_tokens"],
  "masked_columns": ["password_hash", "ssn", "users.email"],
  "max_rows": 200,
  "allowed_statements": [
    "select",
    "with",
    "insert",
    "update",
    "delete",
    "create",
    "alter",
    "drop",
    "truncate",
    "comment"
  ],
  "approval_threshold": "medium",
  "anomaly_write_burst_limit": 20,
  "anomaly_write_burst_window_ms": 60000,
  "blast_radius_probe": false
}
