{
  "name": "forgeguard",
  "version": "0.1.0",
  "private": true,
  "description": "The reliability & observability control plane for agent-built backends on InsForge.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app lib tests scripts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "e2e": "tsx scripts/e2e.ts",
    "seed": "tsx scripts/seed.ts",
    "precommit": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "next": "15.5.18",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.18",
    "tsx": "4.22.4",
    "typescript": "5.5.3"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
