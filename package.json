{
  "name": "forgeguard",
  "version": "0.2.0",
  "private": true,
  "description": "The reliability & observability control plane for agent-built backends on InsForge.",
  "repository": {
    "type": "git",
    "url": "https://github.com/madhukoseke/ForgeGuard.git"
  },
  "bugs": {
    "url": "https://github.com/madhukoseke/ForgeGuard/issues"
  },
  "homepage": "https://github.com/madhukoseke/ForgeGuard#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components hooks lib tests scripts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "e2e": "tsx scripts/e2e.ts",
    "demo:e2e": "tsx scripts/demo-e2e.ts",
    "e2e:replicas": "tsx scripts/replicas-e2e.ts",
    "e2e:limrun": "tsx --env-file=.env.local scripts/limrun-e2e.ts",
    "demo:insforge": "tsx scripts/insforge-live-demo.ts",
    "fix:npm-cache": "bash scripts/fix-npm-cache.sh",
    "seed": "tsx scripts/seed.ts",
    "bootstrap:insforge": "tsx --env-file=.env.local scripts/bootstrap-insforge.ts",
    "integration:insforge": "tsx --env-file=.env.local scripts/insforge-integration.ts",
    "verify:limrun": "tsx --env-file=.env.local scripts/verify-limrun.ts",
    "precommit": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "geist": "^1.7.2",
    "next": "15.5.18",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "^10.5.0",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.18",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "tsx": "4.22.4",
    "typescript": "5.5.3"
  }
}
