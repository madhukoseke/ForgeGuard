# ─── ForgeGuard environment ──────────────────────────────────────────────────
# Everything is OPTIONAL. With no env set, ForgeGuard runs fully on an in-memory
# store + a deterministic heuristic classifier, so the whole demo works offline.

# --- InsForge (DB / Edge Functions / Model Gateway) ---
INSFORGE_URL=
INSFORGE_KEY=

# --- InsForge Model Gateway (OpenAI-compatible) — Layer 2 classifier ---
OPENROUTER_API_KEY=
INSFORGE_MODEL_GATEWAY_URL=https://openrouter.ai/api/v1
FORGEGUARD_MODEL=openai/gpt-4o-mini

# --- Persistence backend selector ---
# "memory" (default) | "insforge"
FORGEGUARD_STORE=memory

# --- Executor: apply/rollback target ---
# "simulated" (default) | "insforge" | "migrations" — requires INSFORGE_URL + INSFORGE_KEY
FORGEGUARD_EXECUTOR=simulated

# --- Optional InsForge CLI branches (local dev only; disabled on Vercel) ---
# Set to "cli" to create/merge/reset InsForge preview branches on apply/rollback.
FORGEGUARD_BRANCH_MODE=

# --- Local/dev app URL used by scripts/seed.ts and scripts/e2e.ts ---
FORGEGUARD_BASE_URL=http://localhost:3000

# --- Optional dashboard/API mutation protection ---
FORGEGUARD_OPERATOR_TOKEN=

# --- Replicas (background coding agent) ---
# API key only needed if ForgeGuard creates replicas programmatically.
REPLICAS_KEY=
REPLICAS_WEBHOOK_SECRET=
REPLICAS_ENVIRONMENT_ID=

# --- Limrun (mobile approval preview) ---
# Org API key from lim.run — creates instances when no reuse id is set.
LIM_API_KEY=
# Reuse an existing iOS instance instead of creating new ones (cost control).
LIMRUN_INSTANCE_ID=
# Minimum severity to attach a preview URL: safe|low|medium|high|critical
LIMRUN_MIN_SEVERITY=medium

# --- Memoir (trymemoir.ai — optional outbound events when API access granted) ---
MEMOIR_WEBHOOK_URL=
