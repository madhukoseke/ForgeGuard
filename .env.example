# ─── ForgeGuard environment ──────────────────────────────────────────────────
# Everything is OPTIONAL. With no env set, ForgeGuard runs fully on an in-memory
# store + a deterministic heuristic classifier, so the whole demo works offline.
# Wire these in once you've verified the InsForge surfaces on the day.

# --- InsForge (DB / Edge Functions / Model Gateway) ---
# Confirm exact names via InsForge MCP `fetch-docs` + docs.insforge.dev
INSFORGE_URL=
INSFORGE_KEY=

# --- InsForge Model Gateway (OpenAI-compatible) — Layer 2 classifier ---
# `insforge ai setup` writes OPENROUTER_API_KEY; INSFORGE_KEY is a fallback.
OPENROUTER_API_KEY=
INSFORGE_MODEL_GATEWAY_URL=https://openrouter.ai/api/v1
FORGEGUARD_MODEL=openai/gpt-4o-mini

# --- Persistence backend selector ---
# "memory" (default) | "insforge"
FORGEGUARD_STORE=memory

# --- Local/dev app URL used by scripts/seed.ts and scripts/e2e.ts ---
FORGEGUARD_BASE_URL=http://localhost:3000

# --- Optional dashboard/API mutation protection ---
# If set, POST/PATCH routes require Authorization: Bearer <token> or
# x-forgeguard-token: <token>. Leave empty for a frictionless local demo.
FORGEGUARD_OPERATOR_TOKEN=

# --- Replicas (stretch — background coding agent) ---
REPLICAS_KEY=

# --- Limrun (stretch — mobile approval UI) ---
LIMRUN_INSTANCE_ID=
